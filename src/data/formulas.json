[
  {
    "id": "algebra", "title": "אלגברה", "topic": "algebra", "icon": "✖️",
    "items": [
      { "id": "sq-sum", "name": "ריבוע סכום והפרש", "tex": "(a \\pm b)^2 = a^2 \\pm 2ab + b^2", "units": [3, 4, 5] },
      { "id": "diff-squares", "name": "הפרש ריבועים", "tex": "a^2 - b^2 = (a - b)(a + b)", "units": [3, 4, 5] },
      { "id": "cube-sum", "name": "חזקה שלישית של סכום והפרש", "tex": "(a \\pm b)^3 = a^3 \\pm 3a^2b + 3ab^2 \\pm b^3", "units": [5] },
      { "id": "sum-cubes", "name": "סכום והפרש של חזקות שלישיות", "tex": "a^3 \\pm b^3 = (a \\pm b)(a^2 \\mp ab + b^2)", "units": [5] },
      { "id": "quadratic", "name": "פתרון משוואה ריבועית", "tex": "ax^2 + bx + c = 0 \\ \\Rightarrow\\ x_{1,2} = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}", "note": "אם $b^2-4ac<0$ אין פתרון ממשי.", "units": [3, 4, 5] },
      { "id": "vieta", "name": "נוסחאות וייטה", "tex": "x_1 + x_2 = -\\frac{b}{a},\\qquad x_1 \\cdot x_2 = \\frac{c}{a}", "units": [4, 5], "extra": true },
      { "id": "factor-quadratic", "name": "פירוק טרינום ריבועי", "tex": "ax^2 + bx + c = a(x - x_1)(x - x_2)", "units": [4, 5], "extra": true },
      { "id": "abs", "name": "ערך מוחלט", "tex": "|x| < a \\iff -a < x < a,\\qquad |x| > a \\iff x > a \\ \\text{או}\\ x < -a", "note": "עבור $a > 0$.", "units": [4, 5], "extra": true }
    ]
  },
  {
    "id": "powers", "title": "חזקות, שורשים ולוגריתמים", "topic": "powers", "icon": "🔢",
    "items": [
      { "id": "pow-mul", "name": "כפל חזקות עם אותו בסיס", "tex": "a^m \\cdot a^n = a^{m+n}", "units": [3, 4, 5] },
      { "id": "pow-div", "name": "חילוק חזקות עם אותו בסיס", "tex": "\\frac{a^m}{a^n} = a^{m-n}", "units": [3, 4, 5] },
      { "id": "pow-pow", "name": "חזקה של חזקה", "tex": "\\left(a^m\\right)^n = a^{m \\cdot n}", "units": [3, 4, 5] },
      { "id": "pow-prod", "name": "חזקה של מכפלה ושל מנה", "tex": "(ab)^n = a^n b^n,\\qquad \\left(\\frac{a}{b}\\right)^n = \\frac{a^n}{b^n}", "units": [3, 4, 5] },
      { "id": "pow-zero-neg", "name": "מעריך אפס ומעריך שלילי", "tex": "a^0 = 1,\\qquad a^{-n} = \\frac{1}{a^n}", "note": "עבור $a \\neq 0$.", "units": [3, 4, 5] },
      { "id": "pow-frac", "name": "מעריך שבור", "tex": "a^{\\frac{m}{n}} = \\sqrt[n]{a^m}", "note": "עבור $a > 0$.", "units": [4, 5] },
      { "id": "roots", "name": "כללי שורשים", "tex": "\\sqrt{ab} = \\sqrt{a}\\sqrt{b},\\qquad \\sqrt{\\frac{a}{b}} = \\frac{\\sqrt{a}}{\\sqrt{b}}", "note": "עבור $a, b \\ge 0$ (ובמנה $b > 0$).", "units": [3, 4, 5] },
      { "id": "log-def", "name": "הגדרת הלוגריתם", "tex": "\\log_a b = c \\iff a^c = b", "note": "עבור $a > 0,\\ a \\neq 1,\\ b > 0$.", "units": [4, 5] },
      { "id": "log-prod", "name": "לוגריתם של מכפלה ושל מנה", "tex": "\\log_a(xy) = \\log_a x + \\log_a y,\\qquad \\log_a\\frac{x}{y} = \\log_a x - \\log_a y", "units": [4, 5] },
      { "id": "log-pow", "name": "לוגריתם של חזקה", "tex": "\\log_a x^n = n\\log_a x", "units": [4, 5] },
      { "id": "log-base", "name": "החלפת בסיס", "tex": "\\log_a b = \\frac{\\log_c b}{\\log_c a}", "units": [4, 5] },
      { "id": "ln", "name": "לוגריתם טבעי", "tex": "\\ln x = \\log_e x,\\qquad e \\approx 2.718", "units": [5] }
    ]
  },
  {
    "id": "sequences", "title": "סדרות", "topic": "sequences", "icon": "🔗",
    "items": [
      { "id": "arith-n", "name": "סדרה חשבונית – איבר כללי", "tex": "a_n = a_1 + (n - 1)d", "units": [3, 4, 5] },
      { "id": "arith-sum", "name": "סדרה חשבונית – סכום", "tex": "S_n = \\frac{n(a_1 + a_n)}{2} = \\frac{n\\left[2a_1 + (n - 1)d\\right]}{2}", "units": [3, 4, 5] },
      { "id": "geo-n", "name": "סדרה הנדסית – איבר כללי", "tex": "a_n = a_1 \\cdot q^{\\,n-1}", "units": [3, 4, 5] },
      { "id": "geo-sum", "name": "סדרה הנדסית – סכום", "tex": "S_n = \\frac{a_1\\left(q^n - 1\\right)}{q - 1}", "note": "עבור $q \\neq 1$.", "units": [3, 4, 5] },
      { "id": "geo-inf", "name": "סכום סדרה הנדסית אינסופית מתכנסת", "tex": "S = \\frac{a_1}{1 - q},\\qquad |q| < 1", "units": [5] },
      { "id": "means", "name": "ממוצע חשבוני וממוצע הנדסי", "tex": "a_n = \\frac{a_{n-1} + a_{n+1}}{2}\\ (\\text{חשבונית}),\\qquad a_n^2 = a_{n-1}\\cdot a_{n+1}\\ (\\text{הנדסית})", "units": [4, 5], "extra": true }
    ]
  },
  {
    "id": "growth", "title": "גדילה ודעיכה", "topic": "growth", "icon": "🌱",
    "items": [
      { "id": "growth-formula", "name": "נוסחת גדילה ודעיכה", "tex": "M_t = M_0 \\cdot q^{\\,t}", "note": "$M_0$ – כמות התחלתית, $q$ – מקדם הגדילה ליחידת זמן, $t$ – מספר יחידות הזמן.", "units": [3, 4, 5] },
      { "id": "growth-percent", "name": "מקדם גדילה לפי אחוזים", "tex": "q = 1 + \\frac{p}{100}\\ (\\text{גדילה}),\\qquad q = 1 - \\frac{p}{100}\\ (\\text{דעיכה})", "units": [3, 4, 5] },
      { "id": "half-life", "name": "זמן מחצית חיים", "tex": "M_0 \\cdot q^{\\,T} = \\frac{M_0}{2} \\ \\Rightarrow\\ q^{\\,T} = \\frac12", "units": [4, 5], "extra": true }
    ]
  },
  {
    "id": "probability", "title": "הסתברות", "topic": "probability", "icon": "🎲",
    "items": [
      { "id": "complement", "name": "מאורע משלים", "tex": "P(\\bar{A}) = 1 - P(A)", "units": [3, 4, 5] },
      { "id": "union", "name": "איחוד מאורעות", "tex": "P(A \\cup B) = P(A) + P(B) - P(A \\cap B)", "units": [3, 4, 5] },
      { "id": "conditional", "name": "הסתברות מותנית", "tex": "P(A \\mid B) = \\frac{P(A \\cap B)}{P(B)}", "units": [4, 5] },
      { "id": "independent", "name": "מאורעות בלתי תלויים", "tex": "P(A \\cap B) = P(A) \\cdot P(B)", "units": [3, 4, 5] },
      { "id": "binomial", "name": "נוסחת ברנולי (התפלגות בינומית)", "tex": "P_n(k) = \\binom{n}{k} p^k (1 - p)^{n - k}", "note": "$n$ ניסויים בלתי תלויים, $p$ הסתברות להצלחה בכל ניסוי, $k$ מספר ההצלחות.", "units": [4, 5] },
      { "id": "binom-coef", "name": "מקדם בינומי", "tex": "\\binom{n}{k} = \\frac{n!}{k!\\,(n - k)!}", "units": [4, 5] }
    ]
  },
  {
    "id": "statistics", "title": "סטטיסטיקה", "topic": "statistics", "icon": "📊",
    "items": [
      { "id": "mean", "name": "ממוצע", "tex": "\\bar{x} = \\frac{x_1 + x_2 + \\dots + x_n}{n}", "units": [3, 4, 5] },
      { "id": "weighted-mean", "name": "ממוצע לפי טבלת שכיחויות", "tex": "\\bar{x} = \\frac{\\sum f_i x_i}{\\sum f_i}", "units": [3, 4, 5] },
      { "id": "std", "name": "סטיית תקן", "tex": "\\sigma = \\sqrt{\\frac{\\sum (x_i - \\bar{x})^2}{n}}", "units": [3, 4, 5] },
      { "id": "z-score", "name": "ציון תקן", "tex": "z = \\frac{x - \\mu}{\\sigma}", "units": [3, 4, 5] },
      { "id": "normal", "name": "התפלגות נורמלית – אחוזים בין סטיות תקן", "tex": "\\mu\\pm\\sigma:\\ 2\\cdot 34.13\\%,\\quad \\mu\\pm2\\sigma:\\ 2(34.13\\% + 13.59\\%),\\quad \\mu\\pm3\\sigma:\\ 2(34.13\\% + 13.59\\% + 2.14\\%)", "note": "בין $\\mu$ ל-$\\mu+\\sigma$: 34.13%. בין $\\mu+\\sigma$ ל-$\\mu+2\\sigma$: 13.59%. בין $\\mu+2\\sigma$ ל-$\\mu+3\\sigma$: 2.14%. מעבר ל-$\\mu+3\\sigma$: 0.13%.", "units": [3, 4, 5] }
    ]
  },
  {
    "id": "analytic", "title": "גאומטריה אנליטית", "topic": "analytic", "icon": "🗺️",
    "items": [
      { "id": "distance", "name": "מרחק בין שתי נקודות", "tex": "d = \\sqrt{(x_2 - x_1)^2 + (y_2 - y_1)^2}", "units": [3, 4, 5] },
      { "id": "midpoint", "name": "אמצע קטע", "tex": "M\\left(\\frac{x_1 + x_2}{2},\\ \\frac{y_1 + y_2}{2}\\right)", "units": [3, 4, 5] },
      { "id": "slope", "name": "שיפוע ישר", "tex": "m = \\frac{y_2 - y_1}{x_2 - x_1} = \\tan\\alpha", "note": "$\\alpha$ – הזווית בין הישר לכיוון החיובי של ציר $x$.", "units": [3, 4, 5] },
      { "id": "line-point-slope", "name": "משוואת ישר לפי נקודה ושיפוע", "tex": "y - y_1 = m(x - x_1)", "units": [3, 4, 5] },
      { "id": "parallel-perp", "name": "ישרים מקבילים ומאונכים", "tex": "\\parallel:\\ m_1 = m_2,\\qquad \\perp:\\ m_1 \\cdot m_2 = -1", "units": [3, 4, 5] },
      { "id": "angle-lines", "name": "זווית בין שני ישרים", "tex": "\\tan\\alpha = \\left|\\frac{m_1 - m_2}{1 + m_1 m_2}\\right|", "units": [5] },
      { "id": "point-line", "name": "מרחק נקודה מישר", "tex": "d = \\frac{|Ax_0 + By_0 + C|}{\\sqrt{A^2 + B^2}}", "note": "הישר בצורה $Ax + By + C = 0$.", "units": [5] },
      { "id": "circle-eq", "name": "משוואת מעגל", "tex": "(x - a)^2 + (y - b)^2 = R^2", "note": "מרכז $(a, b)$ ורדיוס $R$.", "units": [4, 5] },
      { "id": "parabola-locus", "name": "פרבולה כמקום גאומטרי", "tex": "y^2 = 2px:\\quad F\\left(\\frac{p}{2}, 0\\right),\\ \\ x = -\\frac{p}{2}", "note": "ייתכן שהנושא אינו בתוכנית העדכנית של השאלון שלכם. בדקו מול המורה.", "units": [5], "extra": true }
    ]
  },
  {
    "id": "trigonometry", "title": "טריגונומטריה", "topic": "trigonometry", "icon": "📐",
    "items": [
      { "id": "right-trig", "name": "יחסים במשולש ישר זווית", "tex": "\\sin\\alpha = \\frac{a}{c},\\quad \\cos\\alpha = \\frac{b}{c},\\quad \\tan\\alpha = \\frac{a}{b}", "note": "$a$ – הניצב שמול $\\alpha$, $b$ – הניצב שליד $\\alpha$, $c$ – היתר.", "units": [3, 4, 5] },
      { "id": "pyth-identity", "name": "זהות פיתגורית", "tex": "\\sin^2\\alpha + \\cos^2\\alpha = 1", "units": [3, 4, 5] },
      { "id": "tan-identity", "name": "טנגנס כמנה", "tex": "\\tan\\alpha = \\frac{\\sin\\alpha}{\\cos\\alpha},\\qquad 1 + \\tan^2\\alpha = \\frac{1}{\\cos^2\\alpha}", "units": [4, 5] },
      { "id": "sine-law-f", "name": "משפט הסינוסים", "tex": "\\frac{a}{\\sin\\alpha} = \\frac{b}{\\sin\\beta} = \\frac{c}{\\sin\\gamma} = 2R", "units": [4, 5] },
      { "id": "cosine-law-f", "name": "משפט הקוסינוסים", "tex": "c^2 = a^2 + b^2 - 2ab\\cos\\gamma", "units": [4, 5] },
      { "id": "area-trig", "name": "שטח משולש", "tex": "S = \\frac{1}{2}ab\\sin\\gamma", "units": [3, 4, 5] },
      { "id": "reduction", "name": "זוויות משלימות ל-180° ול-90°", "tex": "\\sin(180^\\circ - \\alpha) = \\sin\\alpha,\\quad \\cos(180^\\circ - \\alpha) = -\\cos\\alpha,\\quad \\sin(90^\\circ - \\alpha) = \\cos\\alpha", "units": [4, 5] },
      { "id": "sum-angle", "name": "סינוס וקוסינוס של סכום והפרש", "tex": "\\sin(\\alpha \\pm \\beta) = \\sin\\alpha\\cos\\beta \\pm \\cos\\alpha\\sin\\beta,\\qquad \\cos(\\alpha \\pm \\beta) = \\cos\\alpha\\cos\\beta \\mp \\sin\\alpha\\sin\\beta", "units": [5] },
      { "id": "tan-sum", "name": "טנגנס של סכום והפרש", "tex": "\\tan(\\alpha \\pm \\beta) = \\frac{\\tan\\alpha \\pm \\tan\\beta}{1 \\mp \\tan\\alpha\\tan\\beta}", "units": [5] },
      { "id": "double-angle", "name": "זווית כפולה", "tex": "\\sin2\\alpha = 2\\sin\\alpha\\cos\\alpha,\\qquad \\cos2\\alpha = \\cos^2\\alpha - \\sin^2\\alpha = 2\\cos^2\\alpha - 1 = 1 - 2\\sin^2\\alpha", "units": [5] },
      { "id": "tan-double", "name": "טנגנס של זווית כפולה", "tex": "\\tan2\\alpha = \\frac{2\\tan\\alpha}{1 - \\tan^2\\alpha}", "units": [5] },
      { "id": "trig-eq", "name": "פתרון כללי של משוואות טריגונומטריות", "tex": "\\begin{aligned}\\sin x = \\sin\\alpha &\\Rightarrow x = \\alpha + 360^\\circ k \\ \\text{או}\\ x = 180^\\circ - \\alpha + 360^\\circ k\\\\ \\cos x = \\cos\\alpha &\\Rightarrow x = \\pm\\alpha + 360^\\circ k\\\\ \\tan x = \\tan\\alpha &\\Rightarrow x = \\alpha + 180^\\circ k\\end{aligned}", "note": "$k$ – מספר שלם.", "units": [5] },
      { "id": "radian", "name": "רדיאנים", "tex": "\\pi \\text{ רדיאנים} = 180^\\circ", "units": [5] },
      { "id": "arc-length", "name": "אורך קשת ושטח גזרה", "tex": "\\ell = \\frac{\\alpha}{360^\\circ}\\cdot 2\\pi r,\\qquad S = \\frac{\\alpha}{360^\\circ}\\cdot \\pi r^2", "units": [3, 4, 5] }
    ]
  },
  {
    "id": "areas", "title": "שטחים, היקפים ונפחים", "topic": "area-volume", "icon": "📦",
    "items": [
      { "id": "area-triangle", "name": "שטח משולש", "tex": "S = \\frac{a \\cdot h_a}{2}", "units": [3, 4, 5] },
      { "id": "area-parallelogram", "name": "שטח מקבילית", "tex": "S = a \\cdot h_a", "units": [3, 4, 5] },
      { "id": "area-trapezoid", "name": "שטח טרפז", "tex": "S = \\frac{(a + b)\\cdot h}{2}", "units": [3, 4, 5] },
      { "id": "area-rhombus", "name": "שטח מעוין ודלתון (לפי אלכסונים)", "tex": "S = \\frac{d_1 \\cdot d_2}{2}", "units": [3, 4, 5] },
      { "id": "circle", "name": "עיגול: היקף ושטח", "tex": "P = 2\\pi r,\\qquad S = \\pi r^2", "units": [3, 4, 5] },
      { "id": "prism", "name": "תיבה ומנסרה", "tex": "V = S_{\\text{בסיס}} \\cdot h", "units": [3, 4, 5] },
      { "id": "pyramid", "name": "פירמידה", "tex": "V = \\frac{S_{\\text{בסיס}} \\cdot h}{3}", "units": [3, 4, 5] },
      { "id": "cylinder", "name": "גליל", "tex": "V = \\pi r^2 h,\\qquad M = 2\\pi r h", "note": "$M$ – שטח המעטפת.", "units": [3, 4, 5] },
      { "id": "cone", "name": "חרוט", "tex": "V = \\frac{\\pi r^2 h}{3},\\qquad M = \\pi r \\ell", "note": "$\\ell$ – אורך הקו היוצר.", "units": [3, 4, 5] },
      { "id": "sphere", "name": "כדור", "tex": "V = \\frac{4}{3}\\pi r^3,\\qquad S = 4\\pi r^2", "units": [3, 4, 5] }
    ]
  },
  {
    "id": "derivatives", "title": "חשבון דיפרנציאלי", "topic": "derivatives", "icon": "📉",
    "items": [
      { "id": "d-power", "name": "נגזרת של חזקה", "tex": "\\left(x^n\\right)' = n x^{n - 1}", "units": [3, 4, 5] },
      { "id": "d-const", "name": "קבוע, כפל בקבוע וסכום", "tex": "(c)' = 0,\\qquad (c\\cdot f)' = c\\cdot f',\\qquad (f \\pm g)' = f' \\pm g'", "units": [3, 4, 5] },
      { "id": "d-product", "name": "נגזרת של מכפלה", "tex": "(f \\cdot g)' = f'g + fg'", "units": [4, 5] },
      { "id": "d-quotient", "name": "נגזרת של מנה", "tex": "\\left(\\frac{f}{g}\\right)' = \\frac{f'g - fg'}{g^2}", "units": [4, 5] },
      { "id": "d-chain", "name": "נגזרת של פונקציה מורכבת (כלל השרשרת)", "tex": "\\left[f\\big(g(x)\\big)\\right]' = f'\\big(g(x)\\big)\\cdot g'(x)", "units": [4, 5] },
      { "id": "d-sqrt", "name": "נגזרת של שורש", "tex": "\\left(\\sqrt{x}\\right)' = \\frac{1}{2\\sqrt{x}}", "units": [4, 5] },
      { "id": "d-trig", "name": "נגזרות טריגונומטריות", "tex": "(\\sin x)' = \\cos x,\\qquad (\\cos x)' = -\\sin x,\\qquad (\\tan x)' = \\frac{1}{\\cos^2 x}", "note": "הזווית $x$ ברדיאנים.", "units": [5] },
      { "id": "d-exp", "name": "נגזרת של פונקציה מעריכית", "tex": "\\left(e^x\\right)' = e^x,\\qquad \\left(a^x\\right)' = a^x \\ln a", "units": [5] },
      { "id": "d-log", "name": "נגזרת של לוגריתם", "tex": "(\\ln x)' = \\frac{1}{x},\\qquad (\\log_a x)' = \\frac{1}{x\\ln a}", "units": [5] },
      { "id": "tangent-line", "name": "משוואת המשיק לגרף", "tex": "y - f(x_0) = f'(x_0)(x - x_0)", "units": [3, 4, 5] }
    ]
  },
  {
    "id": "integrals", "title": "חשבון אינטגרלי", "topic": "integrals", "icon": "∫",
    "items": [
      { "id": "i-power", "name": "אינטגרל של חזקה", "tex": "\\int x^n\\,dx = \\frac{x^{n + 1}}{n + 1} + C", "note": "עבור $n \\neq -1$.", "units": [3, 4, 5] },
      { "id": "i-linear", "name": "אינטגרל של חזקה של ביטוי קווי", "tex": "\\int (ax + b)^n\\,dx = \\frac{(ax + b)^{n + 1}}{a(n + 1)} + C", "units": [4, 5] },
      { "id": "i-recip", "name": "אינטגרל של $\\frac{1}{x}$", "tex": "\\int \\frac{1}{x}\\,dx = \\ln|x| + C", "units": [5] },
      { "id": "i-exp", "name": "אינטגרל של פונקציה מעריכית", "tex": "\\int e^x\\,dx = e^x + C,\\qquad \\int e^{ax+b}\\,dx = \\frac{1}{a}e^{ax+b} + C", "units": [5] },
      { "id": "i-trig", "name": "אינטגרלים טריגונומטריים", "tex": "\\int \\sin x\\,dx = -\\cos x + C,\\qquad \\int \\cos x\\,dx = \\sin x + C,\\qquad \\int \\frac{dx}{\\cos^2 x} = \\tan x + C", "units": [5] },
      { "id": "i-definite", "name": "אינטגרל מסוים", "tex": "\\int_a^b f(x)\\,dx = F(b) - F(a)", "note": "$F$ – פונקציה קדומה של $f$.", "units": [3, 4, 5] },
      { "id": "i-area", "name": "שטח בין שני גרפים", "tex": "S = \\int_a^b \\left[f(x) - g(x)\\right]dx", "note": "בתחום שבו $f(x) \\ge g(x)$.", "units": [3, 4, 5] },
      { "id": "i-volume", "name": "נפח גוף סיבוב סביב ציר x", "tex": "V = \\pi\\int_a^b f^2(x)\\,dx", "units": [5] }
    ]
